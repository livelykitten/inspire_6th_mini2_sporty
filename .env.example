# Docker Compose 용 (저장소 루트). 복사해서 .env 로 쓰고 커밋하지 않는다: cp .env.example .env
# IDE · Gradle 로 서비스를 띄울 때 쓰는 값은 backend/.env.example 에 있다 (#61).
# 아래 JWT_SECRET_KEY · ENCRYPT_KEY 는 backend/.env.example 과 같은 값이어야 한다 (config-repo 암호문이 이 키로 만들어짐).

# --- 로컬 인프라 (compose.yaml) ---
# DB 는 서비스당 1대. 호스트 포트만 다르고 컨테이너 안은 모두 3306 이다. 값을 안 적으면 아래 기본값이 쓰인다.
MARIADB_ROOT_PASSWORD=root
USER_DB_PORT=3306
USER_DB_USER=user_svc
USER_DB_PASSWORD=user_svc
MATCH_DB_PORT=3307
MATCH_DB_USER=match_svc
MATCH_DB_PASSWORD=match_svc
FACILITY_DB_PORT=3308
FACILITY_DB_USER=facility_svc
FACILITY_DB_PASSWORD=facility_svc

# --- 앱 컨테이너 (compose.app.yaml) ---
OPEN_AI_KEY=your_openai_key

# JWT 서명 키 (로컬 전용, 32바이트 이상). gateway · user 가 같은 값
# 이 값을 바꾸면 config-repo 의 jwt.secret 암호문도 다시 만들어야 한다 (config-repo/README.md)
JWT_SECRET_KEY=local-only-jwt-secret-change-me-0123456789abcdef

# Config 서버 설정 암호화 키 (로컬 전용). config-repo 의 '{cipher}...' 값을 푼다. 배포 값은 디코 DM (W-25)
ENCRYPT_KEY=local-only-encrypt-key-change-me-0123456789

# 게이트웨이 CORS 허용 오리진 (기본: http://localhost). 배포 때 프론트 주소로 바꾼다
# CORS_ALLOWED_ORIGIN=http://localhost

# 프론트(nginx) 호스트 포트 (기본 80. 이미 쓰고 있으면 바꾼다)
# FRONTEND_PORT=80

# facility-service 시설 동기화. 키가 비어 있으면 동기화는 실패하지만 서비스는 뜬다
# PUBLIC_DATA_API_KEY=
# PUBLIC_DATA_API_URL=
# FACILITY_SYNC_ON_STARTUP=true
