# 로컬 전용 값. 복사해서 .env 로 쓰고 커밋하지 않는다.
# 서비스는 실행 디렉터리 또는 그 상위의 .env 를 읽는다 (backend/{서비스}/.env, backend/.env).

# DB 는 서비스당 1대 (user_db · match_db · facility_db). 서비스별 .env 의 DB_URL 포트만 다르다.
DB_DRIVER=org.mariadb.jdbc.Driver
DB_URL=jdbc:mariadb://localhost:3306/user_db
DB_USERNAME=root
DB_PASSWORD=your_db_password

REDIS_HOST=localhost
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Eureka 없이 단독 기동하려면 false
EUREKA_ENABLED=true
EUREKA_URL=http://localhost:8761/eureka

# config-service 가 읽을 설정 저장소 (기본: 저장소 루트의 config-repo)
# CONFIG_REPO_PATH=file:../../config-repo

OPEN_AI_KEY=your_openai_key

# JWT 서명 키 (로컬 전용, 32바이트 이상). user-service 와 gateway-service 가 반드시 같은 값이어야 한다 (다르면 모든 토큰 401)
JWT_SECRET_KEY=local-only-jwt-secret-change-me-0123456789abcdef

# 게이트웨이 CORS 허용 오리진 (기본: http://localhost:3000). 배포 때 프론트 주소로 바꾼다
# CORS_ALLOWED_ORIGIN=http://localhost:3000
