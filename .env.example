# 로컬 전용 값. 복사해서 .env 로 쓰고 커밋하지 않는다.
# 서비스는 실행 디렉터리 또는 그 상위의 .env 를 읽는다 (backend/{서비스}/.env, backend/.env).

# --- 로컬 인프라 (compose.yaml) ---
# DB 는 서비스당 1대. 호스트 포트만 다르고 컨테이너 안은 모두 3306 이다. 값을 안 적으면 아래 기본값이 쓰인다.
MARIADB_ROOT_PASSWORD=root
USER_DB_PORT=3306
USER_DB_USER=user_svc
USER_DB_PASSWORD=user_svc
MATCH_DB_PORT=3307
MATCH_DB_USER=match_svc
MATCH_DB_PASSWORD=match_svc
FACILITY_DB_PORT=3308
FACILITY_DB_USER=facility_svc
FACILITY_DB_PASSWORD=facility_svc

# --- 서비스 설정 (서비스가 읽는 값) ---
# 서비스마다 기본값이 이미 위 인프라에 맞춰져 있어 보통 적을 필요가 없다.
# 바꿔야 할 때만 서비스 디렉터리의 .env 에 적는다. 예) match-service:
# DB_URL=jdbc:mariadb://localhost:3307/match_db
# DB_USERNAME=match_svc
# DB_PASSWORD=match_svc
DB_DRIVER=org.mariadb.jdbc.Driver

REDIS_HOST=localhost
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Eureka 없이 단독 기동하려면 false
EUREKA_ENABLED=true
EUREKA_URL=http://localhost:8761/eureka

# config-service 가 읽을 설정 저장소 (기본: 저장소 루트의 config-repo)
# CONFIG_REPO_PATH=file:../../config-repo

OPEN_AI_KEY=your_openai_key
