# W-35 AWS 배포용 값의 "키 목록". 값은 저장소에 두지 않는다.
# EC2 의 deploy/ec2/deploy.sh 가 /etc/sporty/aws.env(CloudFormation 이 만든 비밀이 아닌 값)와
# Secrets Manager(비밀값)를 합쳐 /opt/sporty/.env 를 만든다. 직접 만들 일은 없고, 로컬에서 compose.aws.yaml 배선을
# 점검할 때만 이 파일을 .env 로 복사해 쓴다 (RDS 대신 로컬 DB 컨테이너 이름을 준다).

# --- /etc/sporty/aws.env (stack2 user-data 가 작성, 비밀 아님) ---
AWS_REGION=ap-northeast-2
PROJECT_NAME=sporty
ENV_NAME=prod
USER_RDS_ENDPOINT=
MATCH_RDS_ENDPOINT=
FACILITY_RDS_ENDPOINT=
ECR_REGISTRY=
IMAGE_TAG=latest

# --- Secrets Manager 에서 내려받는 값 (stack1 이 생성, 외부 키는 콘솔에서 입력) ---
USER_DB_PASSWORD=
MATCH_DB_PASSWORD=
FACILITY_DB_PASSWORD=
JWT_SECRET_KEY=
ENCRYPT_KEY=
OPEN_AI_KEY=
PUBLIC_DATA_API_KEY=
PUBLIC_DATA_API_URL=

# --- 선택 ---
# HTTPS(인증서)를 쓰면 브라우저 오리진이 https://도메인 이므로 게이트웨이 CORS 허용 오리진을 맞춘다
# CORS_ALLOWED_ORIGIN=https://example.com
# FRONTEND_PORT=80
